{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "db:create": "wrangler d1 create helpxs",
    "db:migrate:local": "wrangler d1 migrations apply helpxs --local",
    "db:migrate:remote": "wrangler d1 migrations apply helpxs --remote"
  },
  "dependencies": {
    "better-auth": "^1.3.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "~6.0.2",
    "wrangler": "^3.99.0"
  }
}
